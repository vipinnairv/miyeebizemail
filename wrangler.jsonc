{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miyeebizemail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Logs from console.log() show up in the dashboard (Workers > Observability)
  // and in `npx wrangler tail`.
  "observability": { "enabled": true },

  // The web inbox is served at https://mail.miyeetechlabs.com. `wrangler deploy`
  // creates this custom domain (and its DNS record) automatically.
  "routes": [{ "pattern": "mail.miyeetechlabs.com", "custom_domain": true }],

  // The web inbox (public/) is served as static assets. Requests that don't
  // match a file (e.g. /api/*) fall through to the Worker's fetch handler.
  "assets": { "directory": "./public" },

  // Plain (non-secret) configuration. Secrets such as API_TOKEN are set with
  // `npx wrangler secret put API_TOKEN` and are NOT listed here.
  "vars": {
    // The address this Worker sends mail from. Must be on a domain that is
    // onboarded to Cloudflare Email Routing / Email Sending.
    "FROM_ADDRESS": "hello@miyeetechlabs.com",
    "FROM_NAME": "Miyee Tech Labs",
    // Optional: copy every inbound message to this mailbox. It must be a
    // *verified destination address* in Email Routing. Leave "" to disable.
    "FORWARD_TO": "",
    // Send an automatic acknowledgement to whoever emails you.
    "AUTO_REPLY": "true",
    // Messages (and their R2 files) older than this are deleted daily.
    "RETENTION_DAYS": "90",
    // Inbound mail scoring at or above this goes to the Spam folder (see src/spam.ts).
    // Lower = stricter. 5 is a balanced starting point.
    "SPAM_THRESHOLD": "5",
    // Spam is deleted after this many days.
    "SPAM_RETENTION_DAYS": "30"
  },

  // Messages, attachment metadata and full-text search index.
  // Create with `npx wrangler d1 create miyeebizemail` and paste the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miyeebizemail",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Original .eml files and attachment bytes.
  // Create with `npx wrangler r2 bucket create miyeebizemail-mail`.
  "r2_buckets": [{ "binding": "MAIL_BUCKET", "bucket_name": "miyeebizemail-mail" }],

  // Outbound email binding (env.EMAIL.send(...)).
  // Restrict which From addresses this Worker may use. You can also add
  // "destination_address" or "allowed_destination_addresses" to lock the
  // binding to specific verified recipients (useful for notification-only Workers).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@miyeetechlabs.com"]
    }
  ],

  // Daily retention cleanup at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] }
}
